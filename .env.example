# Supabase (required for Path 1 identity)
# Create a project at https://supabase.com then copy these from Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only. Used by npm run seed:campus and npm run seed:test.
# Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Public site URL used in auth email redirects (local default).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
